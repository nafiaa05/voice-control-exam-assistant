          ],
          "answer": "Cleaning and interpreting data"
        },
        {
          "question": "Which tool is most commonly used for Data Analysis in Python?",
          "options": [
            "NumPy",
            "pandas",
            "TensorFlow",
            "Django"
          ],
          "answer": "pandas"
        },
        {
          "question": "What is the purpose of Exploratory Data Analysis (EDA)?",
          "options": [
            "To build predictive models",
            "To clean missing values",
            "To summarize and visualize data",
            "To store data in databases"
          ],
          "answer": "To summarize and visualize data"
        },
        {
          "question": "Which of the following is NOT a type of Data Analysis?",
          "options": [
            "Descriptive",
            "Diagnostic",
            "Predictive",
            "Illustrative"
          ],
          "answer": "Illustrative"
        },
        {
          "question": "Which chart is best suited to show the distribution of a dataset?",
