          ],
          "answer": "Histogram"
        },
        {
          "question": "In SQL, which command is used to retrieve data from a database?",
          "options": [
            "SELECT",
            "INSERT",
            "UPDATE",
            "DELETE"
          ],
          "answer": "SELECT"
        },
        {
          "question": "Which measure of central tendency is most affected by outliers?",
          "options": [
            "Mean",
            "Median",
            "Mode",
            "Range"
          ],
          "answer": "Mean"
        },
        {
          "question": "Which of the following is used to detect correlation between two variables?",
          "options": [
            "Regression analysis",
            "Pearson\u2019s correlation coefficient",
            "Chi-square test",
            "ANOVA"
          ],
          "answer": "Pearson\u2019s correlation coefficient"
        },
        {
          "question": "Which visualization is best for showing relationships between two continuous variables?",
          "options": [
            "Bar chart",
            "Scatter plot",
            "Pie chart",
            "Box plot"
          ],
          "answer": "Scatter plot"
        },
        {
          "question": "Which of the following is a supervised machine learning technique used in Data Analysis?",
          "options": [
            "Clustering",
            "Association rule mining",
            "Regression",
            "Dimensionality reduction"
          ],
          "answer": "Regression"
        }
      ],
